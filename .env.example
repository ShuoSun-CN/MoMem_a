# Remote OpenAI backend
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local vLLM backend
VLLM_BASE_URL=http://127.0.0.1:8090
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Local memory stores
MOMEM_MEMORY_DIR=~/.cache/momem
MOMEM_EXPLICIT_MEMORY_PATH=~/.cache/momem/explicit_memory
MOMEM_LOGIC_TRAJECTORY_PATH=~/.cache/momem/logic_trajectory_bank
